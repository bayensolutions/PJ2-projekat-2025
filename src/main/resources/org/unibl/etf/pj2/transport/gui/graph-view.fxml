<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.unibl.etf.pj2.transport.gui.GraphVisualizationController"
            prefWidth="1000"
            prefHeight="800">

    <top>
        <VBox spacing="10" style="-fx-background-color: #f4f4f4;">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Vizualizacija transportnog grafa"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblInfo" text="Gradovi: 0 | Polasci: 0 | Zoom: 100%"/>
            </HBox>

            <HBox spacing="15" alignment="CENTER_LEFT">
                <CheckBox fx:id="chkShowLabels" text="Prikaži nazive"/>
                <CheckBox fx:id="chkShowBusStations" text="Autobuske stanice"/>
                <CheckBox fx:id="chkShowTrainStations" text="Željezničke stanice"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnReset" text="Resetuj prikaz" onAction="#resetView"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <Canvas fx:id="graphCanvas" width="1000" height="700"/>
    </center>

    <bottom>
        <VBox spacing="8" style="-fx-background-color: #f9f9f9; -fx-border-color: #ddd; -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets top="12" right="15" bottom="12" left="15"/>
            </padding>

            <Label text="Legenda:" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>

            <HBox spacing="25">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="●" style="-fx-text-fill: #50C878; -fx-font-size: 20px;"/>
                    <Label text="Grad"/>
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="■" style="-fx-text-fill: #FFB347; -fx-font-size: 16px;"/>
                    <Label text="Autobuska stanica"/>
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="◆" style="-fx-text-fill: #B19CD9; -fx-font-size: 16px;"/>
                    <Label text="Željeznička stanica"/>
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="→" style="-fx-text-fill: #FF4444; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <Label text="Optimalna ruta"/>
                </HBox>
            </HBox>

            <Label text="💡 Koristi scroll za zoom, klikni i povuci za pomicanje"
                   style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
        </VBox>
    </bottom>

</BorderPane>